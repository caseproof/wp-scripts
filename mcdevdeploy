#!/usr/bin/env php
<?php

if (!defined('STDIN')) {
    echo "You're unauthorized to view this page.\n";
    exit(1);
}

if (!isset($argv[1])) {
    echo "Usage: ./script/mcdevdeploy [version-number]\n";
    exit(1);
}

$version = $argv[1];

// Accepts X.Y.Z, the legacy MemberPress prerelease convention (1.2.3rc1) and
// semver prereleases (1.2.3-rc.1).
if (!preg_match('/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+|([a-z_][a-z_-]*)\d+)?$/iD', $version)) {
    echo "Improper version format.\n";
    exit(1);
}

if (getcwd() !== dirname(__DIR__)) {
    echo "This script must be run from within the plugin root directory.\n";
    exit(1);
}

if (!file_exists(__DIR__ . '/wp-script-config.php')) {
    echo "The script/wp-script-config.php file wasn't found.\n";
    exit(1);
}

require __DIR__ . '/wp-script-config.php';

// A plugin hosted on wordpress.org is deployed by its own workflow when the
// version tag is pushed, so it needs a Stable tag line in its readme instead
// of a Mothership project.
$wporg_only = defined('WP_SCRIPT_WPORG_ONLY') && WP_SCRIPT_WPORG_ONLY === true;

if ($wporg_only) {
    if (!is_file('./readme.txt') || !preg_match('/^Stable tag:/m', file_get_contents('./readme.txt'))) {
        echo "WP_SCRIPT_WPORG_ONLY is set but there is no readme.txt with a Stable tag line.\n";
        exit(1);
    }
} elseif (empty(MOTHERSHIP_URL) || empty(MOTHERSHIP_API_KEY) || empty(MOTHERSHIP_PROJECT_ID)) {
    echo "The MOTHERSHIP_URL, MOTHERSHIP_API_KEY, and MOTHERSHIP_PROJECT_ID constants must be defined in script/wp-script-config.php\n";
    exit(1);
}

echo "!! Deploying version \"{$version}\"\n";

if ($wporg_only) {
    echo "!! WP_SCRIPT_WPORG_ONLY is set: no Mothership deploy and no [ci skip] on the bump commit\n";
}

if (!defined('MY_PLUGIN_MAIN_FILE')) {
    define('MY_PLUGIN_MAIN_FILE', WP_SCRIPT_TEXTDOMAIN . '.php');
}

echo "!! Merging develop into master and issuing release\n";

$commands   = array();
$commands[] = "/usr/bin/git checkout develop";
$commands[] = "/usr/bin/git pull origin develop";
$commands[] = "/usr/bin/git checkout master";
$commands[] = "/usr/bin/git pull origin master";
$commands[] = "/usr/bin/git merge develop";
$commands[] = "/usr/bin/git push origin master";
$commands[] = "/usr/bin/perl -p -i -e 's/^Version: (.*)$/Version: {$version}/' ./" . MY_PLUGIN_MAIN_FILE;

// wordpress.org serves the tag that the readme names as stable, so an X.Y.Z
// release sets the readme's Stable tag to the new version in the same commit
// as the version header. Prereleases leave the Stable tag alone.
if ($wporg_only && preg_match('/^\d+\.\d+\.\d+$/D', $version)) {
    $commands[] = "/usr/bin/perl -p -i -e 's/^Stable tag:.*?(\\r?)$/Stable tag: {$version}\$1/' ./readme.txt";
}

$commands[] = './script/mki18n';
$commands[] = './script/rmlb';
$commands[] = './script/cleartrailingwhitespace';
$commands[] = './script/rmtabs';

// The release tag points at the bump commit, and GitHub starts no push
// workflows for a commit whose message contains [ci skip], tag pushes
// included. A wordpress.org deploy runs from that tag push. Other plugins
// keep the marker so the bump commit pushed to master and develop starts
// none of their push workflows.
$ci_skip = $wporg_only ? '' : ' [ci skip]';

$commands[] = "/usr/bin/git commit -am 'Bump master to version {$version}{$ci_skip}'";
$commands[] = "/usr/bin/git push origin master";
$commands[] = "/usr/bin/git tag {$version}";
$commands[] = "/usr/bin/git push origin {$version}";

if (!$wporg_only) {
    $commands[] = '/usr/bin/curl -d "apikey=' . MOTHERSHIP_API_KEY . '" ' . MOTHERSHIP_URL . '/versions/deploy/' . MOTHERSHIP_PROJECT_ID . '/' . $version;
}

$commands[] = "/usr/bin/git checkout develop";
$commands[] = "/usr/bin/git merge master";
$commands[] = "/usr/bin/git push origin develop";

foreach ($commands as $command) {
    echo "\n$command\n";
    system($command);
    sleep(1);
}

echo "!! Merged master back into develop and pushed to \"origin develop\"\n";

exit(0);
